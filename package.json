{
	"name": "remember-scroll-position",
	"version": "1.0.16",
	"description": "Remembers your cursor and scroll position for each note",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"scroll",
		"cursor",
		"position"
	],
	"author": "Diana <diana@madebydia.com>",
	"license": "MIT",
	"dependencies": {
		"monkey-around": "3.0.0"
	},
	"devDependencies": {
		"@types/node": "22.19.20",
		"builtin-modules": "5.2.0",
		"esbuild": "0.28.0",
		"obsidian": "1.13.0",
		"tslib": "2.8.1",
		"typescript": "5.9.3"
	}
}
